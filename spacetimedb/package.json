{
  "name": "@kavach/spacetimedb",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "spacetime build",
    "publish:local": "spacetime publish --server local kavach-dev -y --no-config",
    "generate": "spacetime generate --lang typescript --out-dir ../agent/photon-worker/src/module_bindings",
    "call:local": "spacetime call --server local kavach-dev --no-config set_development_status"
  },
  "dependencies": {
    "spacetimedb": "2.14.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
