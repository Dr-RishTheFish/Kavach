# Kavach — every secret and config value. Copy to .env and fill in. Never commit .env.
APP_DISPLAY_NAME=Kavach

# SpacetimeDB
SPACETIME_URI=http://127.0.0.1:3000
SPACETIME_DB_NAME=kavach
# Shared secret a service presents once via claim_service(role, key) to bind its identity to a role
SERVICE_CLAIM_KEY=change-me
# Per-service SpacetimeDB tokens (created by scripts/service_tokens.ts; one identity per service)
SPACETIME_TOKEN_AGENTS=
SPACETIME_TOKEN_PHOTON=
SPACETIME_TOKEN_VOICE=
SPACETIME_TOKEN_ADMIN=

# NVIDIA NIM (build.nvidia.com, OpenAI-compatible)
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_WRITER=nvidia/nemotron-3.5-super-vl-120b-a12b
MODEL_VISION=nvidia/nemotron-3.5-super-vl-120b-a12b
NIM_THINKING=off
MODEL_EMBED=nvidia/nemotron-3.5-embed-1b

# Agent service
AGENT_SERVICE_URL=http://127.0.0.1:8088
AGENT_SERVICE_TOKEN=change-me-too

# Photon Spectrum (spectrum-ts)
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_AGENT_LINE=
# console = local terminal gateway for development; photon = real iMessage line
MESSAGING_GATEWAY=console

# Telephony for the voice hotline (Pipecat)
TELEPHONY_PROVIDER=twilio
TELEPHONY_ACCOUNT_SID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_NUMBER=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
VOICE_PORT=8765

# APNs
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
APNS_TOPIC=com.hack.kavach.app

# Shortens timers, uses seeded personas, caches demo verdicts
DEMO_MODE=true
