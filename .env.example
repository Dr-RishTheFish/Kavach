# Kavach configuration. Copy to .env and fill in. Never commit .env.

# SpacetimeDB, hosted on Maincloud (dashboard: https://spacetimedb.com/kavach-qnc3a)
# For a local server instead: SPACETIME_URI=http://localhost:3000 and run `spacetime start`.
SPACETIME_URI=https://maincloud.spacetimedb.com
SPACETIME_DB_NAME=kavach-qnc3a
SPACETIME_TOKEN=            # your own token: run `spacetime login show --token` (never share it)
SERVICE_KEY=                # shared secret services use to register their identity

# Photon (messaging gateway, used only by backend/photon-worker)
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
PHOTON_AGENT_USER_ID=
PHOTON_WEBHOOK_SECRET=

# NVIDIA NIM, hosted inference from build.nvidia.com (no local GPU needed)
NIM_API_KEY=                # from "Get API Key" on build.nvidia.com
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_FAST=                 # model id from the model's API example, e.g. a Nemotron Nano model
MODEL_WRITER=               # optional larger model id for longer writing tasks

# Agent service (photon-worker expects this to be set)
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_TOKEN=

DEMO_MODE=true
