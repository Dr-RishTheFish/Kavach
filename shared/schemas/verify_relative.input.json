{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "person_id": {
      "type": "integer",
      "minimum": 1
    },
    "relative_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "claim_from_e164": {
      "type": "string",
      "pattern": "^(\\+[1-9]\\d{6,14})?$"
    }
  },
  "required": [
    "person_id",
    "relative_name"
  ],
  "additionalProperties": true,
  "title": "POST /run/verify_relative"
}
