    "ok": {
      "type": "boolean"
    },
    "incident_id": {
      "type": "integer"
    },
    "severity": {
      "type": "string"
    },
    "request_key": {
      "type": "string"
    },
    "duplicate": {
      "type": "boolean"
    },
    "answers_saved": {
      "type": "integer"
    },
