{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "safe",
        "suspicious",
        "likely_scam"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "tactics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      },
      "maxItems": 3
    }
  },
  "required": [
    "verdict",
    "reason",
    "tactics"
  ],
  "additionalProperties": true,
  "title": "MODEL_FAST classification"
}
