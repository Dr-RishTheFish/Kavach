{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /run/command",
  "type": "object",
  "properties": {
    "person_id": {
      "type": "integer",
      "minimum": 1
    },
    "text": {
      "type": "string",
      "maxLength": 2000
    },
    "reply_to_e164": {
      "type": "string"
    },
    "reply_channel": {
      "type": "string"
    },
    "args": {
      "type": "object",
      "description": "Optional pre-parsed action from the router: {action, phone?, link?, target?, name?, relationship?, code_word?, label?, correct?}"
    }
  },
  "required": [
    "person_id"
  ],
  "additionalProperties": true
}
