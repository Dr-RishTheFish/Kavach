{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "maxLength": 8000
    },
    "source": {
      "enum": [
        "app_paste",
        "share",
        "screenshot"
      ]
    },
    "sender_e164": {
      "type": "string",
      "pattern": "^(\\+[1-9]\\d{6,14})?$"
    },
    "image_base64": {
      "type": "string"
    }
  },
  "required": [
    "source"
  ],
  "additionalProperties": true,
  "title": "POST /app/check"
}
