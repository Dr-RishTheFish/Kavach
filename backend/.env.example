# kavach backend. Copy to backend/.env for local settings. Never commit .env.
HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# mock (default, offline) | nvidia (live NVIDIA hosted inference, fails closed with 503)
ANALYSIS_PROVIDER=mock

# Module 1: required when ANALYSIS_PROVIDER=nvidia. Server-side only, never in ios/.
NVIDIA_API_KEY=
NVIDIA_MODEL=              # an id from your account's model list: npm run smoke:nvidia -- --models
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_MS=15000
NVIDIA_THINKING=off        # off = skip hidden reasoning on reasoning models (faster); default = send nothing

# Future modules, NOT used yet (leave empty):
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SPACETIMEDB_URI=
SPACETIMEDB_MODULE=
