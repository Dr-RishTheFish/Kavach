// Kavach build configuration. The ONLY place the product name and backend defaults live.
// Note: "//" starts a comment in xcconfig files, so URLs use the "http:/$()/" trick.

// Display name everywhere (CFBundleDisplayName, Siri phrases via .applicationName, UI copy).
APP_DISPLAY_NAME = Kavach

// SpacetimeDB HTTP API and database. On a real iPhone use the Mac's LAN IP, e.g. http:/$()/192.168.1.20:3000
SPACETIME_URL = http:/$()/127.0.0.1:3000
SPACETIME_DB_NAME = kavach

// Agent service (agents/). On a real iPhone use the Mac's LAN IP.
AGENT_SERVICE_URL = http:/$()/127.0.0.1:8088

// The agent's iMessage line (Photon shared line, E.164). Onboarding offers to save it as a contact;
// "Text Kavach" opens Messages to it. The only place this number lives in the app.
AGENT_LINE_NUMBER = +14156106180

APP_GROUP_ID = group.com.hack.kavach.app

// Optional local overrides that are not committed (e.g. your LAN IP). Create Config/Local.xcconfig.
#include? "Local.xcconfig"
